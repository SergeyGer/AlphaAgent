# AlphaAgent environment template.
#
#   cp .env.example .env    # then fill in the values below
#
# NEVER commit the resulting .env - it is already listed in .gitignore.
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-64-char-random-string
# Keep false in production; true enables debug pages and verbose errors.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# Must match the credentials of the `db` service in docker-compose.yml,
# which reads this same variable.
POSTGRES_DB=alpha_agent_db
POSTGRES_USER=alpha_user
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- AI layer -------------------------------------------------------------
# provider: deepseek | openai | anthropic | none
# 'none', or an empty API key, uses the deterministic offline decision engine.
AI_LLM_PROVIDER=deepseek
# Verify the model ID before use - providers retire them regularly:
#   python -c "from anthropic import Anthropic; print([m.id for m in Anthropic().models.list()])"
AI_LLM_MODEL=deepseek-reasoner
AI_LLM_API_KEY=
# Leave blank for the provider default; set it for OpenAI-compatible gateways.
AI_LLM_BASE_URL=
# Required when your Anthropic account uses Workspaces and the key is not
# scoped to one. Anthropic then rejects every request with HTTP 400 unless an
# `anthropic-workspace-id` header is present. Find the ID in the Anthropic
# Console under Settings -> Workspaces. CrewAI does not send it, so the app
# injects it via a transport interceptor.
AI_LLM_WORKSPACE_ID=
# Escape hatch for gateways/proxies: a JSON object of extra request headers.
AI_LLM_EXTRA_HEADERS=
AI_LLM_TEMPERATURE=0.2
AI_LLM_MAX_TOKENS=2048
AI_REQUEST_TIMEOUT=90
AI_MAX_RETRIES=2

# --- AI spend ceiling -----------------------------------------------------
# Hard daily ceiling on language-model spend, across every portfolio. The
# execution guard caps what the system may TRADE; this caps what it may COST.
# Without it, an unattended Beat schedule keeps calling the model forever,
# refusing every trade on risk grounds while the API bill grows.
#
# Must be non-zero. A ceiling of 0 would be indistinguishable from "disabled",
# and a spending control that silently defaults to off is worse than none - it
# implies protection that is not there. $5/day is a few hundred Haiku debate
# runs: enough to be useful, small enough that a runaway loop is caught inside
# one billing cycle.
AI_DAILY_SPEND_LIMIT_USD=5.00

# Set to false to keep running past the ceiling while still tracking and
# displaying the spend. Useful for a demo; leave it true for anything autonomous.
AI_SPEND_LIMIT_ENFORCED=true
# true  -> fall back to the deterministic engine when the LLM is unavailable
# false -> fail loudly (recommended when real trades depend on the model)
AI_ALLOW_HEURISTIC_FALLBACK=true

# --- MCP tool server ------------------------------------------------------
# Route the crew's tools through the MCP microservice instead of calling the
# service layer in-process. Off by default (one less network hop); turn it on to
# prove that the same tools serve external MCP clients too.
AI_TOOLS_VIA_MCP=false
AI_MCP_SERVER_URL=http://127.0.0.1:8100/mcp
MCP_PORT=8100
MCP_HOST=0.0.0.0

# Shared secret for the MCP server, sent as the X-AlphaAgent-MCP-Key header.
# Required: the server refuses to start on an HTTP transport without it, because
# it is reachable over the network. It is never published to the host - the
# service sits on the compose network only - so this is the second of two
# controls rather than the only one.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SHARED_SECRET=dev-only-mcp-shared-secret-change-me

# --- Human-in-the-loop approvals ------------------------------------------
# How long an AI proposal stays actionable before it auto-expires. Prices move,
# so a stale proposal is worse than no proposal.
RECOMMENDATION_TTL_MINUTES=60

# --- Telegram bot (optional) ----------------------------------------------
# Create a bot with @BotFather and paste the token here. Leave blank to disable
# the integration entirely - the rest of the platform is unaffected.
# Interactive buttons (approve/reject trades, balance reports) are English-only.
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram echoes back on every webhook call, so the endpoint can
# prove a request really came from Telegram. Required in production.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL for the webhook, e.g. https://alpha.example.com/api/telegram/webhook/
# Leave blank for local development and use: python manage.py telegram_poll
TELEGRAM_WEBHOOK_URL=
TELEGRAM_REQUEST_TIMEOUT=15

# --- Frontend -------------------------------------------------------------
# Where the compiled React SPA lives. Django serves it when the build exists.
SPA_DIST_DIR=frontend/dist

# --- Trading universe -----------------------------------------------------
ALPHA_WATCHLIST=AAPL,TSLA,BTC
