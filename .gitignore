# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Never commit a credential handed over for a one-off authenticated push.
.git-token
*.token
*.pat

# Sandbox/tooling artefacts from the development environment. Not part of
# the project: nothing in the codebase references this file.
cordis.patch.yml

# Release archives and database exports never belong in git.
*.tar.gz
*.tgz
*.zip
.runtime/exports/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log

# Vitest coverage output (the badge and the floor are computed in CI; this is
# local scratch, and it rewrites on every run)
frontend/coverage/
logs/
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# ---------------------------------------------------------------------------
# Local runtime state (CrewAI credentials/cache, sandbox HOME)
# ---------------------------------------------------------------------------
.runtime/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
