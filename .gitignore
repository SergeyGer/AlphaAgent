# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Never commit a credential handed over for a one-off authenticated push.
# Credential files. The glob covers a trailing space, which is a common paste
# artefact - it made `.git-token ` invisible to the plain pattern and it was
# staged by `git add -A` before anyone noticed.
.git-token*
*.token
*.pat

# Sandbox/tooling artefacts from the development environment. Not part of
# the project: nothing in the codebase references this file.
cordis.patch.yml

# Release archives and database exports never belong in git.
*.tar.gz
*.tgz
*.zip
.runtime/exports/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log

# Vitest coverage output (the badge and the floor are computed in CI; this is
# local scratch, and it rewrites on every run)
frontend/coverage/
logs/
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# ---------------------------------------------------------------------------
# Local runtime state (CrewAI credentials/cache, sandbox HOME)
# ---------------------------------------------------------------------------
.runtime/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
# Personal run/stop guide, generated by scripts/make_run_stop_doc.py.
# Deliberately NOT tracked: it is a reference for one operator rather than a
# project artefact, and a binary Word rewrites on every open would add nothing to
# the history but noise. The generator that produces it IS tracked, so the
# document can be rebuilt whenever the commands change.
Run_Stop_Project.docx
Run_Stop_Project*.docx

# VS Code: ignore personal settings, but TRACK the shared tasks and extension
# recommendations. This project is worked on from several machines, so a task
# that only exists on the laptop it was written on is not a workflow.
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
