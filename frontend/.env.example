# Base URL for REST calls. Leave empty to use same-origin relative URLs
# (recommended: in dev the Vite proxy forwards /api and /ws to http://127.0.0.1:8000).
VITE_API_BASE=

# Optional explicit WebSocket origin. When empty the origin is derived from
# VITE_API_BASE (if absolute) or from window.location (ws:// or wss://).
# VITE_WS_BASE=ws://127.0.0.1:8000
