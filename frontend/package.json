{
  "name": "alphaagent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AlphaAgent \u2014 autonomous AI investment platform dashboard (React SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
