# AlphaAgent - development and CI tooling (DIRECT ONLY).
#
# Compiled into requirements-dev.txt by:
#
#     make lock-dev      # or: pip-compile --generate-hashes requirements-dev.in
#
# The compiled output contains the whole runtime tree plus the tools below. That
# duplication is deliberate: pip enables hash-checking mode as soon as a
# requirements file contains any hash, so every requirement in the install -
# runtime and tooling alike - must carry hashes or the install fails outright.

-r requirements.in

ruff==0.16.10          # linting + formatting (replaces flake8/isort/black)
pre-commit==4.6.2      # git hook runner
pip-tools==7.6.1       # `make lock` / `make lock-dev`
coverage==7.16.2       # test coverage, enforced by the CI test job
                       # coverage.svg is rendered by scripts/coverage_badge.py
